---
import Layout from '../layouts/Layout.astro';
---

<Layout title="R&L Labs, LLC - Projects" currentPath="/projects">
  <section class="page-header">
    <div class="container">
      <h1>Our Projects</h1>
      <p>Explore the coding projects we've built and continue to develop</p>
    </div>
  </section>

  <section class="projects">
    <div class="container">
      <div class="projects-grid">
        <a class="project-card project-card-link afterlight-project" href="/afterlight">
          <div class="project-image">
            <img
              src="/afterlight/signal-reliquary.webp"
              alt="The AFTERLIGHT Far Relay rising beyond a dark stone signal platform"
              width="1600"
              height="900"
            />
          </div>
          <div class="project-content">
            <h3>AFTERLIGHT</h3>
            <p>A story-driven NeoForge modpack built around lost infrastructure, guided automation, and a private expedition through the Far Relay.</p>
            <div class="project-tags">
              <span class="tag">Minecraft</span>
              <span class="tag">NeoForge</span>
              <span class="tag">Download Portal</span>
            </div>
          </div>
        </a>
        <div class="project-card">
          <div class="project-image">
            <div class="project-placeholder">⚡</div>
          </div>
          <div class="project-content">
            <h3>Crypto Sniping Bot</h3>
            <p>A high-performance trading interface designed for the XRP Ledger. This tool provides users with a single, streamlined interface to quickly buy and sell coins on the XRP chain, offering significantly faster execution times compared to other major platforms.</p>
            <div class="project-tags">
              <span class="tag">XRP Ledger</span>
              <span class="tag">Trading Bot</span>
              <span class="tag">Private</span>
            </div>
          </div>
        </div>
        <div class="project-card">
          <div class="project-image">
            <div class="project-placeholder">🎯</div>
          </div>
          <div class="project-content">
            <h3>Hedgelock</h3>
            <p>A sports betting tool that automatically monitors and alerts users of hedging opportunities for their active bets. Designed to help bettors optimize their positions and minimize risk. Currently in active development with an expected launch in Q4 2025.</p>
            <div class="project-tags">
              <span class="tag">Sports Betting</span>
              <span class="tag">Automation</span>
              <span class="tag">In Development</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .project-card-link {
    color: inherit;
    text-decoration: none;
  }

  .project-card-link:focus-visible {
    outline: 3px solid #f59e0b;
    outline-offset: 5px;
  }

  .afterlight-project .project-image {
    background: #070a0b;
  }

  .afterlight-project .project-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
